 \u1086\'3f\u1073\'3f\u1098\'3f\u1077\'3f\u1082\'3f\u1090\'3f\u1086\'3f\u1074\'3f \u1087\'3f\u1086\'3f\u1087\'3f\u1072\'3f\u1083\'3f\u1072\'3f \u1074\'3f \u1090\'3f\u1086\'3f\u1087\'3f-k \u1074\'3f\u1099\'3f\u1076\'3f\u1072\'3f\u1095\'3f\u1080\'3f.}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
\u1042\'3f \u1082\'3f\u1083\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1084\'3f \u1087\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1082\'3f\u1077\'3f \u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f\u1086\'3f\u1074\'3f \u1092\'3f\u1086\'3f\u1088\'3f\u1084\'3f\u1091\'3f\u1083\'3f\u1072\'3f \u1074\'3f\u1099\'3f\u1075\'3f\u1083\'3f\u1103\'3f\u1076\'3f\u1080\'3f\u1090\'3f \u1090\'3f\u1072\'3f\u1082\'3f:}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
Recall@k=\u8739\'3f\{\u1056\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1077\'3f\~\u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f\u1099\'3f\}\u8745\'3f\{\u1058\'3f\u1086\'3f\u1087\'3f-k\~\u1074\'3f\u1099\'3f\u1076\'3f\u1072\'3f\u1095\'3f\u1072\'3f\}\u8739\'3f\u1088\'3f\u1072\'3f\u1079\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1085\'3f\u1072\'3f\u8739\'3f\{\u1042\'3f\u1089\'3f\u1077\'3f\~\u1088\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1077\'3f\~\u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f\u1099\'3f\~\u1074\'3f\~\u1073\'3f\u1072\'3f\u1079\'3f\u1077\'3f\}}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
\u1042\'3f \u1079\'3f\u1072\'3f\u1076\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1093\'3f \u1074\'3f\u1077\'3f\u1082\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1082\'3f\u1072\'3f (ANN) \u1095\'3f\u1072\'3f\u1097\'3f\u1077\'3f \u1080\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1079\'3f\u1091\'3f\u1102\'3f\u1090\'3f \u1076\'3f\u1088\'3f\u1091\'3f\u1075\'3f\u1086\'3f\u1077\'3f, \u1073\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1077\'3f \u1089\'3f\u1090\'3f\u1088\'3f\u1086\'3f\u1075\'3f\u1086\'3f\u1077\'3f \u1086\'3f\u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f:\line \u1052\'3f\u1099\'3f \u1079\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1077\'3f\u1077\'3f \u1089\'3f \u1087\'3f\u1086\'3f\u1084\'3f\u1086\'3f\u1097\'3f\u1100\'3f\u1102\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1073\'3f\u1086\'3f\u1088\'3f\u1072\'3f (ground truth) \u1079\'3f\u1085\'3f\u1072\'3f\u1077\'3f\u1084\'3f \u1085\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1103\'3f\u1097\'3f\u1080\'3f\u1093\'3f \u171\'ab\u1073\'3f\u1083\'3f\u1080\'3f\u1078\'3f\u1072\'3f\u1081\'3f\u1096\'3f\u1080\'3f\u1093\'3f \u1089\'3f\u1086\'3f\u1089\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1081\'3f\u187\'bb \u1079\'3f\u1072\'3f\u1087\'3f\u1088\'3f\u1086\'3f\u1089\'3f\u1072\'3f. Recall@k \u1090\'3f\u1086\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u8212\'97 \u1076\'3f\u1086\'3f\u1083\'3f\u1103\'3f }{\cs16\rtlch\ai\ltrch\hich\ai\dbch\ai\loch\i
\u1080\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f}{
 \u1073\'3f\u1083\'3f\u1080\'3f\u1078\'3f\u1072\'3f\u1081\'3f\u1096\'3f\u1080\'3f\u1093\'3f \u1089\'3f\u1086\'3f\u1089\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1081\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1072\'3f\u1083\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1084\'3f \u1089\'3f\u1084\'3f\u1086\'3f\u1075\'3f \u1085\'3f\u1072\'3f\u1081\'3f\u1090\'3f\u1080\'3f \u1089\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1080\'3f \u1074\'3f\u1077\'3f\u1088\'3f\u1085\'3f\u1091\'3f\u1090\'3f\u1099\'3f\u1093\'3f k \u1088\'3f\u1077\'3f\u1079\'3f\u1091\'3f\u1083\'3f\u1100\'3f\u1090\'3f\u1072\'3f\u1090\'3f\u1086\'3f\u1074\'3f:}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
Recall@k=\u8739\'3f\{\u1055\'3f\u1088\'3f\u1080\'3f\u1073\'3f\u1083\'3f\u1080\'3f\u1078\'3f\u1105\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f\~\u1090\'3f\u1086\'3f\u1087\'3f-k\}\u8745\'3f\{\u1048\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f\~\u1090\'3f\u1086\'3f\u1087\'3f-k\}\u8739\'3f \u1088\'3f\u1072\'3f\u1079\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1085\'3f\u1072\'3f k\u8203\'3f}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
\u1045\'3f\u1089\'3f\u1083\'3f\u1080\'3f \u1084\'3f\u1086\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1100\'3f \u1076\'3f\u1086\'3f\u1083\'3f\u1078\'3f\u1085\'3f\u1072\'3f \u1073\'3f\u1099\'3f\u1083\'3f\u1072\'3f \u1085\'3f\u1072\'3f\u1081\'3f\u1090\'3f\u1080\'3f 10 \u1089\'3f\u1072\'3f\u1084\'3f\u1099\'3f\u1093\'3f \u1088\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f\u1086\'3f\u1074\'3f (k=10), \u1072\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1073\'3f\u1083\'3f\u1080\'3f\u1078\'3f\u1105\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1072\'3f\u1083\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1084\'3f \u1074\'3f\u1077\'3f\u1088\'3f\u1085\'3f\u1091\'3f\u1083\'3f 9 \u1080\'3f\u1079\'3f \u1085\'3f\u1080\'3f\u1093\'3f, \u1090\'3f\u1086\'3f Recall@10 = 0.9.}
\par \pard\plain \s3\ilvl2\outlinelevel2\sb140\sa120\rtlch\af10\afs28\ab\ltrch\hich\af3\afs28\ab\dbch\af9\loch\f3\fs28\b\sl276\slmult1\ql\fi0\li0\lin0\ri0\rin0\sb0\sa140\ltrpar{
2. \u1055\'3f\u1086\'3f\u1095\'3f\u1077\'3f\u1084\'3f\u1091\'3f Recall@k \u1074\'3f\u1072\'3f\u1078\'3f\u1085\'3f\u1077\'3f\u1077\'3f Latency (\u1079\'3f\u1072\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1082\'3f\u1080\'3f)}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140\ql\ltrpar{
\u1058\'3f\u1077\'3f\u1079\'3f\u1080\'3f\u1089\'3f \u171\'abRecall \u1074\'3f\u1072\'3f\u1078\'3f\u1085\'3f\u1077\'3f\u1077\'3f latency\u187\'bb \u1089\'3f\u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1077\'3f\u1076\'3f\u1083\'3f\u1080\'3f\u1074\'3f \u1085\'3f\u1077\'3f \u1072\'3f\u1073\'3f\u1089\'3f\u1086\'3f\u1083\'3f\u1102\'3f\u1090\'3f\u1085\'3f\u1086\'3f, \u1072\'3f \u1074\'3f \u1088\'3f\u1072\'3f\u1084\'3f\u1082\'3f\u1072\'3f\u1093\'3f \u1086\'3f\u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1105\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1082\'3f\u1086\'3f\u1084\'3f\u1087\'3f\u1088\'3f\u1086\'3f\u1084\'3f\u1080\'3f\u1089\'3f\u1089\'3f\u1072\'3f \u1080\'3f \u1087\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1075\'3f\u1086\'3f\u1074\'3f\u1099\'3f\u1093\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f.}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140{\listtext\pard\plain \rtlch\af4\ltrch\hich\af4\dbch\af4\loch\f4 \u8226\'95\tab}\ilvl0\ls34 \fi-283\li0\lin0\ql\tx709\fi-283\li709\lin709\ltrpar{\cs15\rtlch\ab\ltrch\hich\ab\dbch\ab\loch\b
\u1057\'3f\u1084\'3f\u1099\'3f\u1089\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1086\'3f\u1081\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1090\'3f \u1082\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1072\'3f.}{
\line \u1045\'3f\u1089\'3f\u1083\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1103\'3f \u1089\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1077\'3f\u1084\'3f\u1072\'3f (\u1080\'3f\u1083\'3f\u1080\'3f RAG-\u1087\'3f\u1072\'3f\u1081\'3f\u1087\'3f\u1083\'3f\u1072\'3f\u1081\'3f\u1085\'3f) \u1087\'3f\u1088\'3f\u1086\'3f\u1087\'3f\u1091\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1088\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f, \u1090\'3f\u1086\'3f \u1103\'3f\u1079\'3f\u1099\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1103\'3f \u1084\'3f\u1086\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1100\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1085\'3f\u1077\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1085\'3f\u1091\'3f\u1102\'3f \u1080\'3f\u1083\'3f\u1080\'3f \u1085\'3f\u1077\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1085\'3f\u1091\'3f\u1102\'3f \u1080\'3f\u1085\'3f\u1092\'3f\u1086\'3f\u1088\'3f\u1084\'3f\u1072\'3f\u1094\'3f\u1080\'3f\u1102\'3f. \u1048\'3f\u1090\'3f\u1086\'3f\u1075\'3f\u1086\'3f\u1074\'3f\u1099\'3f\u1081\'3f \u1086\'3f\u1090\'3f\u1074\'3f\u1077\'3f\u1090\'3f \u1089\'3f\u1090\'3f\u1072\'3f\u1085\'3f\u1086\'3f\u1074\'3f\u1080\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1073\'3f\u1077\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1079\'3f\u1085\'3f\u1099\'3f\u1084\'3f \u1080\'3f\u1083\'3f\u1080\'3f \u1074\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1085\'3f\u1099\'3f\u1084\'3f. \u1055\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1079\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1089\'3f\u1090\'3f \u1079\'3f\u1072\'3f\u1087\'3f\u1088\'3f\u1086\'3f\u1089\'3f: \u171\'ab\u1044\'3f\u1072\'3f\u1081\'3f \u1084\'3f\u1085\'3f\u1077\'3f \u1080\'3f\u1085\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1091\'3f\u1082\'3f\u1094\'3f\u1080\'3f\u1102\'3f \u1082\'3f \u1084\'3f\u1086\'3f\u1077\'3f\u1081\'3f \u1084\'3f\u1086\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1080\'3f \u1082\'3f\u1086\'3f\u1092\'3f\u1077\'3f\u1084\'3f\u1072\'3f\u1096\'3f\u1080\'3f\u1085\'3f\u1099\'3f\u187\'bb \u8212\'97 \u1077\'3f\u1089\'3f\u1083\'3f\u1080\'3f \u1088\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1084\'3f\u1072\'3f\u1085\'3f\u1091\'3f\u1072\'3f\u1083\'3f \u1087\'3f\u1086\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1103\'3f\u1085\'3f \u1080\'3f\u1079\'3f-\u1079\'3f\u1072\'3f \u1085\'3f\u1080\'3f\u1079\'3f\u1082\'3f\u1086\'3f\u1075\'3f\u1086\'3f recall, \u1086\'3f\u1090\'3f\u1074\'3f\u1077\'3f\u1090\'3f \u1073\'3f\u1091\'3f\u1076\'3f\u1077\'3f\u1090\'3f \u1083\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1099\'3f\u1084\'3f. \u1047\'3f\u1072\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1082\'3f\u1072\'3f \u1074\'3f 200 \u1084\'3f\u1089\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1090\'3f\u1080\'3f\u1074\'3f 50 \u1084\'3f\u1089\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1097\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f, \u1085\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1086\'3f\u1090\'3f\u1074\'3f\u1077\'3f\u1090\'3f \u8212\'97 \u1085\'3f\u1077\'3f\u1090\'3f.}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140{\listtext\pard\plain \rtlch\af4\ltrch\hich\af4\dbch\af4\loch\f4 \u8226\'95\tab}\ilvl0\ls34 \fi-283\li0\lin0\ql\tx709\fi-283\li709\lin709\ltrpar{\cs15\rtlch\ab\ltrch\hich\ab\dbch\ab\loch\b
\u1069\'3f\u1092\'3f\u1092\'3f\u1077\'3f\u1082\'3f\u1090\'3f \u1073\'3f\u1091\'3f\u1090\'3f\u1099\'3f\u1083\'3f\u1086\'3f\u1095\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1075\'3f\u1086\'3f\u1088\'3f\u1083\'3f\u1099\'3f\u1096\'3f\u1082\'3f\u1072\'3f.}{
\line \u1042\'3f RAG-\u1082\'3f\u1086\'3f\u1085\'3f\u1074\'3f\u1077\'3f\u1081\'3f\u1077\'3f\u1088\'3f\u1077\'3f \u1085\'3f\u1077\'3f\u1074\'3f\u1072\'3f\u1078\'3f\u1085\'3f\u1086\'3f, \u1085\'3f\u1072\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1082\'3f\u1086\'3f \u1073\'3f\u1099\'3f\u1089\'3f\u1090\'3f\u1088\'3f \u1087\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1082\'3f, \u1077\'3f\u1089\'3f\u1083\'3f\u1080\'3f \u1086\'3f\u1085\'3f \u1085\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1080\'3f\u1090\'3f \u1085\'3f\u1091\'3f\u1078\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1092\'3f\u1072\'3f\u1082\'3f\u1090\'3f\u1099\'3f. \u1043\'3f\u1077\'3f\u1085\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1080\'3f\u1074\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1095\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1100\'3f (LLM) \u1085\'3f\u1077\'3f \u1089\'3f\u1084\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1090\'3f \u171\'ab\u1076\'3f\u1086\'3f\u1076\'3f\u1091\'3f\u1084\'3f\u1072\'3f\u1090\'3f\u1100\'3f\u187\'bb \u1086\'3f\u1090\'3f\u1089\'3f\u1091\'3f\u1090\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1091\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1077\'3f \u1076\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1077\'3f. \u1053\'3f\u1080\'3f\u1079\'3f\u1082\'3f\u1080\'3f\u1081\'3f recall \u1085\'3f\u1072\'3f\u1087\'3f\u1088\'3f\u1103\'3f\u1084\'3f\u1091\'3f\u1102\'3f \u1087\'3f\u1086\'3f\u1088\'3f\u1090\'3f\u1080\'3f\u1090\'3f \u1092\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1099\'3f\u1081\'3f outcome, \u1090\'3f\u1086\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u1082\'3f\u1072\'3f\u1082\'3f \u1095\'3f\u1091\'3f\u1090\'3f\u1100\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1096\'3f\u1072\'3f\u1103\'3f latency \u1074\'3f\u1083\'3f\u1080\'3f\u1103\'3f\u1077\'3f\u1090\'3f \u1083\'3f\u1080\'3f\u1096\'3f\u1100\'3f \u1085\'3f\u1072\'3f \u1086\'3f\u1097\'3f\u1091\'3f\u1097\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1079\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1103\'3f.}
\par \pard\plain \s21\sl276\slmult1\sb0\sa140{\listtext\pard\plain \rtlch\af4\ltrch\hich\af4\dbch\af4\loch\f4 \u8226\'95\tab}\ilvl0\ls34 \fi-283\li0\lin0\ql\tx709\fi-283\li709\lin709\ltrpar{\cs15\rtlch\ab\ltrch\hich\ab\dbch\ab\loch\b
\u1055\'3f\u1088\'3f\u1080\'3f\u1077\'3f\u1084\'3f\u1083\'3f\u1077\'3f\u1084\'3f\u1099\'3f\u1081\'3f \u1087\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1075\'3f \u1079\'3f\u1072\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1082\'3f\u1080\'3f.}{
\line \u1053\'3f\u1072\'3f \u1087\'3f\u1088\'3f\u1072\'3f\u1082\'3f\u1090\'3f\u1080\'3f\u1082\'3f\u1077\'3f \u1079\'3f\u1072\'3f\u1076\'3f\u1072\'3f\u1102\'3f\u1090\'3f \u1094\'3f\u1077\'3f\u1083\'3f\u1077\'3f\u1074\'3f\u1086\'3f\u1081\'3f \u1091\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1085\'3f\u1100\'3f \u1079\'3f\u1072\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1082\'3f\u1080\'3f (\u1085\'3f\u1072\'3f\u1087\'3f\u1088\'3f\u1080\'3f\u1084\'3f\u1077\'3f\u1088\'3f, < 100 \u1084\'3f\u1089\'3f), \u1074\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1093\'3f \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1084\'3f\u1072\'3f\u1085\'3f\u1077\'3f\u1074\'3f\u1088\'3f\u1080\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1100\'3f. \u1055\'3f\u1088\'3f\u1080\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1090\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u1086\'3f\u1090\'3f\u1076\'3f\u1072\'3f\u1105\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1084\'3f\u1072\'3f\u1082\'3f\u1089\'3f\u1080\'3f\u1084\'3f\u1080\'3f\u1079\'3f\u1072\'3f\u1094\'3f\u1080\'3f\u1080\'3f recall \u1074\'3f \u1088\'3f\u1072\'3f\u1084\'3f\u1082\'3f\u1072\'3f\u1093\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1073\'3f\u1102\'3f\u1076\'3f\u1078\'3f\u1077\'3f\u1090\'3f\u1072\'3f. \u1058\'3f\u1086\'3f \u1077\'3f\u1089\'3f\u1090\'3f\u1100\'3f, \u171\'ab\u1074\'3f\u1072\'3f\u1078\'3f\u1085\'3f\u1077\'3f\u1077\'3f\u187\'bb \u1085\'3f\u1077\'3f \u1086\'3f\u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1077\'3f\u1090\'3f, \u1095\'3f\u1090\'3f\u1086\'3f latency \u1080\'3f\u1075\'3f\u1085\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1088\'3f\u1091\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u8212\'97 \u1101\'3f\u1090\'3f\u1086\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1080\'3f\u1090\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1084\'3f\u1099\'3f \u1089\'3f\u1082\'3f\u1086\'3f\u1088\'3f\u1077\'3f\u1077\'3f \u1074\'3f\u1099\'3f\u1073\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1084\'3f \u1095\'3f\u1091\'3f\u1090\'3f\u1100\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1077\'3f \u1084\'3f\u1077\'3f\u1076\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1072\'3f\u1083\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1084\'3f, \u1076\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1081\'3f recall 0.99, \u1095\'3f\u1077\'3f\u1084\'3f \u1089\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1093\'3f\u1073\'3f\u1099\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1099\'3f\u1081\'3f \u1089\'3f recall 0.85, \u1087\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1095\'3f\u1090\'3f\u1086\'3f 15% \u1087\'3f\u1086\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1103\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1076\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u8212\'97 \u1082\'3f\u1072\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1086\'3f\u1092\'3f\u1072\'3f \u1076\'3f\u1083\'3f\u1103\'3f \u1082\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1072\'3f \u1086\'3f\u1090\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1072\'3f.}
